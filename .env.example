# KickUp — copy to .env and fill in your values
# Docker: docker-compose reads .env from this folder when you run docker-compose up

PORT_API=3008
PORT_BATCH=4008

# MongoDB (Atlas or local)
MONGO_DEV=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/Kickup
MONGO_PROD=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/Kickup

# Auth
JWT_SECRET=your-secret-key-min-16-chars
ADMIN_SECRET_KEY=your-admin-secret

# CORS (ixtiyoriy): vergul bilan bir nechta origin. Bo‘lmasa — devda barcha origin ruxsat.
# kickup-next: http://localhost:4000 yoki http://127.0.0.1:4000
# CORS_ORIGIN=http://localhost:4000,http://127.0.0.1:4000

# Optional: base URL for upload links (default: http://localhost:3008)
# API_URL=http://localhost:3008

# --- Frontend (kickup-next) bilan ---
# kickup docker-compose: host port 4002 → konteyner 3008 (GraphQL: http://localhost:4002/graphql)
# kickup-next (Docker) ichidagi Next.js proxy: GRAPHQL_PROXY_TARGET=http://host.docker.internal:4002/graphql
